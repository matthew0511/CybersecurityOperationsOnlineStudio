{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Online Studio web runtime, private ECS/ALB, HTTPS API Gateway, build pipeline and management audit trail",
  "Parameters": {
    "VpcId": {
      "Type": "String"
    },
    "AppSubnetA": {
      "Type": "String"
    },
    "AppSubnetB": {
      "Type": "String"
    },
    "TaskSecurityGroup": {
      "Type": "String"
    },
    "DatabaseHost": {
      "Type": "String"
    },
    "MasterSecretArn": {
      "Type": "String"
    },
    "RepositoryUri": {
      "Type": "String"
    },
    "ImageTag": {
      "Type": "String"
    },
    "DeployService": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    },
    "PlatformDbSecretArn": {
      "Type": "String"
    },
    "AuthKeySecretArn": {
      "Type": "String"
    },
    "ScanBucketName": {
      "Type": "String"
    },
    "EnablePlatform": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    },
    "SourceCommit": {
      "Type": "String",
      "AllowedPattern": "[a-f0-9]{40}",
      "Description": "Pinned and validated GitHub source commit for the default build"
    },
    "ApplicationImageTag": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "[A-Za-z0-9_.-]*",
      "Description": "Optional application-only image tag; leaves migration and restore images unchanged"
    }
  },
  "Conditions": {
    "ServiceEnabled": {
      "Fn::Equals": [
        {
          "Ref": "DeployService"
        },
        "true"
      ]
    },
    "PlatformEnabled": {
      "Fn::Equals": [
        {
          "Ref": "EnablePlatform"
        },
        "true"
      ]
    },
    "ApplicationImageOverride": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "ApplicationImageTag"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "BuildBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "cyber-ops-online-studio-build-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireBuildSources",
              "Status": "Enabled",
              "Prefix": "source/",
              "ExpirationInDays": 30,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Cyber Security Operations Online Studio"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AuditBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "cyber-ops-online-studio-audit-${AWS::AccountId}-${AWS::Region}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Cyber Security Operations Online Studio"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AuditBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "AuditBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "s3:GetBucketAcl",
              "Resource": {
                "Fn::GetAtt": [
                  "AuditBucket",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudtrail:${AWS::Region}:${AWS::AccountId}:trail/cyber-ops-online-studio-management"
                  }
                }
              }
            },
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudtrail.amazonaws.com"
              },
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${AuditBucket.Arn}/AWSLogs/${AWS::AccountId}/*"
              },
              "Condition": {
                "StringEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:cloudtrail:${AWS::Region}:${AWS::AccountId}:trail/cyber-ops-online-studio-management"
                  },
                  "s3:x-amz-acl": "bucket-owner-full-control"
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "AuditBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${AuditBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "Trail": {
      "Type": "AWS::CloudTrail::Trail",
      "Properties": {
        "TrailName": "cyber-ops-online-studio-management",
        "S3BucketName": {
          "Ref": "AuditBucket"
        },
        "IsLogging": true,
        "IsMultiRegionTrail": true,
        "IncludeGlobalServiceEvents": true,
        "EnableLogFileValidation": true,
        "EventSelectors": [
          {
            "IncludeManagementEvents": true,
            "ReadWriteType": "All"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Cyber Security Operations Online Studio"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          }
        ]
      },
      "DependsOn": [
        "AuditBucketPolicy"
      ]
    },
    "LogsKey": {
      "Type": "AWS::KMS::Key",
      "Properties": {
        "EnableKeyRotation": true,
        "Description": "Online Studio operational log encryption",
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            },
            {
              "Effect": "Allow",
              "Principal": {
                "Service": {
                  "Fn::Sub": "logs.${AWS::Region}.amazonaws.com"
                }
              },
              "Action": [
                "kms:Encrypt",
                "kms:Decrypt",
                "kms:ReEncrypt*",
                "kms:GenerateDataKey*",
                "kms:DescribeKey"
              ],
              "Resource": "*",
              "Condition": {
                "ArnLike": {
                  "kms:EncryptionContext:aws:logs:arn": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:*"
                  }
                }
              }
            }
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "BuildLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/codebuild/cyber-ops-online-studio",
        "RetentionInDays": 30,
        "KmsKeyId": {
          "Fn::GetAtt": [
            "LogsKey",
            "Arn"
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Cyber Security Operations Online Studio"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "AppLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ecs/cyber-ops-online-studio-web",
        "RetentionInDays": 30,
        "KmsKeyId": {
          "Fn::GetAtt": [
            "LogsKey",
            "Arn"
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Cyber Security Operations Online Studio"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/apigateway/cyber-ops-online-studio",
        "RetentionInDays": 30,
        "KmsKeyId": {
          "Fn::GetAtt": [
            "LogsKey",
            "Arn"
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Cyber Security Operations Online Studio"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DatabaseSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": "cyber-ops-online-studio-dev/application-db",
        "Description": "Least-privilege PostgreSQL application credentials",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"studioapp\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 48,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Cyber Security Operations Online Studio"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "SetupSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": "cyber-ops-online-studio-dev/setup",
        "Description": "One-time owner bootstrap code. Consumed by creation of the first owner account.",
        "GenerateSecretString": {
          "PasswordLength": 48,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Cyber Security Operations Online Studio"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          }
        ]
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "BuildRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "codebuild.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ScopedBuild",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject",
                    "s3:GetObjectVersion"
                  ],
                  "Resource": {
                    "Fn::Sub": "${BuildBucket.Arn}/source/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetBucketLocation"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "BuildBucket",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${BuildLogs.Arn}:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage",
                    "ecr:InitiateLayerUpload",
                    "ecr:UploadLayerPart",
                    "ecr:CompleteLayerUpload",
                    "ecr:PutImage"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/cyber-ops-online-studio-dev"
                  }
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Cyber Security Operations Online Studio"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          }
        ]
      }
    },
    "Builder": {
      "Type": "AWS::CodeBuild::Project",
      "Properties": {
        "Name": "cyber-ops-online-studio-web",
        "ServiceRole": {
          "Fn::GetAtt": [
            "BuildRole",
            "Arn"
          ]
        },
        "TimeoutInMinutes": 30,
        "QueuedTimeoutInMinutes": 15,
        "Artifacts": {
          "Type": "NO_ARTIFACTS"
        },
        "Source": {
          "Type": "GITHUB",
          "Location": "https://github.com/matthew0511/CybersecurityOperationsOnlineStudio.git",
          "BuildSpec": "infra/experience-buildspec.yml"
        },
        "Environment": {
          "Type": "LINUX_CONTAINER",
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/standard:7.0",
          "PrivilegedMode": true,
          "EnvironmentVariables": [
            {
              "Name": "IMAGE_URI",
              "Value": {
                "Fn::If": [
                  "ApplicationImageOverride",
                  {
                    "Fn::Join": [
                      ":",
                      [
                        {
                          "Ref": "RepositoryUri"
                        },
                        {
                          "Ref": "ApplicationImageTag"
                        }
                      ]
                    ]
                  },
                  {
                    "Fn::Join": [
                      ":",
                      [
                        {
                          "Ref": "RepositoryUri"
                        },
                        {
                          "Ref": "ImageTag"
                        }
                      ]
                    ]
                  }
                ]
              }
            },
            {
              "Name": "REGISTRY",
              "Value": {
                "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com"
              }
            }
          ]
        },
        "LogsConfig": {
          "CloudWatchLogs": {
            "Status": "ENABLED",
            "GroupName": {
              "Ref": "BuildLogs"
            },
            "StreamName": "build"
          }
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Cyber Security Operations Online Studio"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          }
        ],
        "SourceVersion": {
          "Ref": "SourceCommit"
        }
      }
    },
    "RuntimeExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ScopedExecution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/cyber-ops-online-studio-dev"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${AppLogs.Arn}:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "DatabaseSecret"
                    },
                    {
                      "Ref": "SetupSecret"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "PlatformDbSecretArn"
                    },
                    {
                      "Ref": "AuthKeySecretArn"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Cyber Security Operations Online Studio"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          }
        ]
      }
    },
    "MigrationExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ScopedExecution",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:BatchCheckLayerAvailability",
                    "ecr:GetDownloadUrlForLayer",
                    "ecr:BatchGetImage"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ecr:${AWS::Region}:${AWS::AccountId}:repository/cyber-ops-online-studio-dev"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ecr:GetAuthorizationToken"
                  ],
                  "Resource": "*"
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${AppLogs.Arn}:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "DatabaseSecret"
                    },
                    {
                      "Ref": "MasterSecretArn"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "PlatformDbSecretArn"
                    },
                    {
                      "Ref": "AuthKeySecretArn"
                    }
                  ]
                }
              ]
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Cyber Security Operations Online Studio"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          }
        ]
      }
    },
    "ApplicationTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "Cyber Security Operations Online Studio"
          },
          {
            "Key": "Environment",
            "Value": "dev"
          }
        ],
        "Policies": [
          {
            "PolicyName": "PlatformRuntime",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObjectVersionTagging"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ScanBucketName}/uploads/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ses:GetEmailIdentity",
                    "ses:SendEmail"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ses:${AWS::Region}:${AWS::AccountId}:identity/cybersecurityoperationstudio.com"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ApplicationTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "cyber-ops-online-studio-web",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "512",
        "Memory": "1024",
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "RuntimeExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "ApplicationTaskRole",
            "Arn"
          ]
        },
        "RuntimePlatform": {
          "OperatingSystemFamily": "LINUX",
          "CpuArchitecture": "X86_64"
        },
        "Volumes": [
          {
            "Name": "scratch"
          }
        ],
        "ContainerDefinitions": [
          {
            "Name": "studio",
            "Image": {
              "Fn::If": [
                "ApplicationImageOverride",
                {
                  "Fn::Join": [
                    ":",
                    [
                      {
                        "Ref": "RepositoryUri"
                      },
                      {
                        "Ref": "ApplicationImageTag"
                      }
                    ]
                  ]
                },
                {
                  "Fn::Join": [
                    ":",
                    [
                      {
                        "Ref": "RepositoryUri"
                      },
                      {
                        "Ref": "ImageTag"
                      }
                    ]
                  ]
                }
              ]
            },
            "Essential": true,
            "User": "10001:10001",
            "ReadonlyRootFilesystem": true,
            "LinuxParameters": {
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              }
            },
            "Environment": [
              {
                "Name": "DB_HOST",
                "Value": {
                  "Ref": "DatabaseHost"
                }
              },
              {
                "Name": "DB_NAME",
                "Value": "cyberops"
              },
              {
                "Name": "APP_ENV",
                "Value": "production"
              },
              {
                "Name": "SCAN_BUCKET",
                "Value": {
                  "Ref": "ScanBucketName"
                }
              },
              {
                "Name": "PUBLIC_ORIGIN",
                "Value": "https://cybersecurityoperationstudio.com"
              },
              {
                "Name": "AWS_REGION",
                "Value": {
                  "Ref": "AWS::Region"
                }
              }
            ],
            "Secrets": [
              {
                "Name": "DB_USER",
                "ValueFrom": {
                  "Fn::If": [
                    "PlatformEnabled",
                    {
                      "Fn::Sub": "${PlatformDbSecretArn}:username::"
                    },
                    {
                      "Fn::Sub": "${DatabaseSecret}:username::"
                    }
                  ]
                }
              },
              {
                "Name": "DB_PASSWORD",
                "ValueFrom": {
                  "Fn::If": [
                    "PlatformEnabled",
                    {
                      "Fn::Sub": "${PlatformDbSecretArn}:password::"
                    },
                    {
                      "Fn::Sub": "${DatabaseSecret}:password::"
                    }
                  ]
                }
              },
              {
                "Name": "SETUP_TOKEN",
                "ValueFrom": {
                  "Ref": "SetupSecret"
                }
              },
              {
                "Name": "AUTH_ENCRYPTION_KEY",
                "ValueFrom": {
